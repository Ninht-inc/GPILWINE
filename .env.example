# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here

# AWS S3 (for file uploads)
AWS_PROFILE=your-profile
AWS_REGION=your-region
AWS_BUCKET_NAME=your-bucket
AWS_FOLDER_PREFIX=your-prefix

# Outgoing email — cPanel / webmail SMTP
# These are fallbacks. Preferred: configure them in the admin panel at /admin/email-settings
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=GPIL Wines
SMTP_ENABLED=true

# Where new form submissions are emailed (fallback for the admin-panel setting)
DEFAULT_ADMIN_NOTIFICATION_EMAIL=orders@yourdomain.com

# Abacus AI API (legacy email fallback — optional once SMTP is configured)
ABACUSAI_API_KEY=your-api-key
WEB_APP_ID=your-app-id

# Notification IDs
NOTIF_ID_QUOTE_REQUEST_ADMIN=
NOTIF_ID_QUOTE_REQUEST_CUSTOMER_CONFIRMATION=
NOTIF_ID_CONTACT_FORM_ADMIN=
NOTIF_ID_CONTACT_FORM_CUSTOMER_CONFIRMATION=
NOTIF_ID_DISTRIBUTOR_ENQUIRY_ADMIN=
NOTIF_ID_DISTRIBUTOR_ENQUIRY_APPLICANT_CONFIRMATION=
NOTIF_ID_STOCKIST_REQUEST_ADMIN=
NOTIF_ID_STOCKIST_REQUEST_CUSTOMER_CONFIRMATION=
