# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-domain

# Cloudinary (image uploads + hosting)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: exposed to the browser for building delivery URLs (defaults to the cloud name above)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Outgoing email — cPanel / webmail SMTP.
# Preferred: configure these in the admin panel at /admin/email-settings; these are the fallback.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=GPIL Wines
SMTP_ENABLED=true

# Where new form submissions are emailed (fallback for the admin-panel setting)
DEFAULT_ADMIN_NOTIFICATION_EMAIL=orders@yourdomain.com

# Bootstrap admin for `yarn prisma db seed` (only used if the user doesn't exist yet)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
