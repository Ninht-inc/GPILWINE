# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-domain

# Cloudinary (image uploads + hosting)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: exposed to the browser for building delivery URLs (defaults to the cloud name above)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Outgoing email — Resend API (https://resend.com). Vercel blocks outbound SMTP,
# so all site email is sent via Resend. The sending domain must be verified there.
RESEND_API_KEY=re_your_api_key
# Optional — overrides the default "GPIL WINE <admin@gpilwine.com>"
RESEND_FROM=GPIL WINE <admin@gpilwine.com>

# Where new form submissions are emailed (fallback for the /admin/email-settings setting)
DEFAULT_ADMIN_NOTIFICATION_EMAIL=admin@gpilwine.com

# DEPRECATED — SMTP is no longer used (kept so old configs don't error). Safe to delete.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Bootstrap admin for `yarn prisma db seed` (only used if the user doesn't exist yet)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
